# Copy to .env; set your own local values. Never commit .env.
PORT=3000
HOST=127.0.0.1
POSTGRES_DB=personas_analytics
POSTGRES_USER=personas
POSTGRES_PASSWORD=
DATABASE_URL=
ADMIN_TOKEN=
RETENTION_DAYS=30
# For a remote DB, use sslmode=verify-full with a trusted CA. Local Docker uses no TLS.

# Local dashboard; credentials stay on its server.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
